#!/usr/bin/env bash
#
# Pre-commit hook: run backport-script unit tests.
# Stored in hooks/ so it's tracked by git.
#
# Activate with:
#   git config core.hooksPath hooks
# Or:
#   make hooks
#

set -euo pipefail

# Only run tests when backport-related files are being committed.
CHANGED=$(git diff --cached --name-only --diff-filter=ACMR -- \
    '.github/scripts/auto-backport-jira.py' \
    '.github/tests/' \
    'hooks/pre-commit' \
    2>/dev/null || true)

if [ -z "$CHANGED" ]; then
    exit 0
fi

echo "pre-commit: backport-related files changed, running tests..."

# Some scripts under .github/scripts/ use 3.10+ syntax (e.g. PEP 604 unions).
# Prefer a modern versioned interpreter over a plain "python3" that may resolve
# to an older system Python (e.g. macOS's /usr/bin/python3, still 3.9).
PYTHON_BIN=""
for candidate in python3.13 python3.12 python3.11 python3.10 python3; do
    if command -v "$candidate" &>/dev/null; then
        PYTHON_BIN="$candidate"
        break
    fi
done

if [ -z "$PYTHON_BIN" ]; then
    echo "WARNING: no python3 found, skipping pre-commit tests"
    exit 0
fi

if ! "$PYTHON_BIN" -m pytest --version &>/dev/null; then
    echo "WARNING: pytest not installed for $PYTHON_BIN, skipping pre-commit tests"
    echo "  Install with: $PYTHON_BIN -m pip install -r .github/tests/requirements-test.txt"
    exit 0
fi

if ! "$PYTHON_BIN" -m pytest .github/tests/ -q --tb=short; then
    echo ""
    echo "pre-commit: TESTS FAILED -- commit aborted."
    exit 1
fi

echo "pre-commit: all checks passed."
